# ------------------------------------------------------------------
# FICHIER .env.example — TEMPLATE VERSIONNÉ
# ------------------------------------------------------------------
# Ce fichier sert d'exemple pour créer votre .env local.
# Copiez ce fichier vers .env et remplacez la valeur de la clé API.
#
# NE JAMAIS METTRE VOTRE CLÉ RÉELLE DANS CE FICHIER !
# Le .env réel DOIT rester privé et NE JAMAIS être commit.
# ------------------------------------------------------------------
# Pour obtenir votre clé Thunderforest :
#   1. Créez un compte sur https://www.thunderforest.com/
#   2. Générez une nouvelle clé API dans la console
#   3. Copiez-la ci-dessous après le =
# ------------------------------------------------------------------

THUNDERFOREST_API_KEY=votre_cle_api_thunderforest_ici